{
  "name": "notas-cli",
  "version": "0.6.0",
  "description": "Terminal activity to structured documentation",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "notas": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "tui": "node dist/cli.js review",
    "test": "vitest run",
    "pkg": "pkg . --targets node18-win-x64,node18-linux-x64 --output dist/notas"
  },
  "dependencies": {
    "axios": "1.18.1",
    "blessed": "^0.1.81",
    "commander": "^11.1.0",
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "pkg": "^5.8.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "overrides": {
    "ws": "^8.21.0",
    "form-data": "^4.0.6"
  }
}
